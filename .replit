modules = ["nodejs-20", "web", "python-3.12"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
build = ["sh", "-c", "set -e; pnpm install --filter @workspace/numatik... --frozen-lockfile || pnpm install --filter @workspace/numatik...; pnpm --filter @workspace/numatik run build"]
run = ["pnpm", "--filter", "@workspace/numatik", "run", "serve"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Start application"

[[workflows.workflow]]
name = "Start application"
mode = "parallel"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sh -c 'set -e; sh scripts/ensure-numatik-deps.sh; exec pnpm --filter @workspace/numatik run dev'"
waitForPort = 18860

[[workflows.workflow]]
name = "artifacts/numatik: web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sh ../../scripts/ensure-numatik-deps.sh && exec pnpm --filter @workspace/numatik run dev"
waitForPort = 18860

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["freetype", "gumbo", "harfbuzz", "jbig2dec", "libjpeg_turbo", "mupdf", "openjpeg", "swig", "xcbuild"]
